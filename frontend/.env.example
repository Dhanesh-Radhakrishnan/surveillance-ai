# frontend/.env.example
# Copy to frontend/.env.local (gitignored) and fill in per-machine.
#
# W5T3: WebSocket URL for the live event feed (backend/api/routes/ws_events.py).
# W5T8 will change this from localhost to the RTX laptop's LAN IP once the
# frontend is actually running on the i5 machine instead of alongside the backend.
VITE_WS_URL=ws://localhost:8000/ws/events
VITE_API_URL=http://localhost:8000
