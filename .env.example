# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# PostgreSQL — used by docker-compose.yml, backend/db/session.py, ai-worker/config.py
POSTGRES_USER=surveillance
POSTGRES_PASSWORD=changeme
POSTGRES_DB=surveillance_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full DSN for Alembic — the '@' in a password must be percent-encoded as %40
DATABASE_URL=postgresql+asyncpg://surveillance:changeme@localhost:5432/surveillance_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Ollama
OLLAMA_BASE_URL=http://localhost:11434